---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { getGalleryItems } from "../utils/social-content";
import { ABOUT_SERVICE_COLLAGE, getPageImage } from "../utils/site-media";

const { entry: page, cacheHint: pageCacheHint } = await getEmDashEntry(
	"pages",
	"about",
);
const galleryResult = await getGalleryItems(6);

if (Astro.cache?.enabled) {
	Astro.cache.set(pageCacheHint);
	Astro.cache.set(galleryResult.cacheHint);
}

const galleryItems = galleryResult.items.filter((item) => item.src);
const aboutHero = getPageImage("aboutHero");
---

<Base
	title="About"
	description="Learn about DB Enhance, a full-service unisex salon in Bangalore and Chennai offering salon hair care, hair fixing, nail art, skin, and grooming services."
	image={aboutHero}
	fullWidth
	content={page ? { collection: "pages", id: page.data.id, slug: "about" } : undefined}
>
	<section class="page-hero page-hero--visual page-hero--short">
		<img
			class="page-hero__bg"
			src={aboutHero}
			alt=""
		/>
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">DB Enhance</p>
			<h1 {...page?.edit.title}>{page?.data.title ?? "About Us"}</h1>
			<p class="page-hero__lead">
				The Unisex Salon — your destination for complete personal care in
				Bangalore and Chennai.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="split split--visual">
			<div class="split__content">
				{page?.data.content ? (
					<PortableText value={page.data.content} />
				) : (
					<div class="article__body">
						<p>
							DB Enhance — The Unisex Salon — is your destination for complete
							personal care in Bangalore and Chennai. From non-surgical hair
							fixing and extensions to nail care, bridal makeup, and everyday
							salon services, we focus on results that feel natural and polished.
						</p>
						<p>
							Visit us in Basavanagudi, Bengaluru, or Padur, Chennai — two
							branches, one brand standard.
						</p>
					</div>
				)}
			</div>
			<div class="split__media">
				<div class="service-collage" aria-label="DB Enhance services">
					{
						ABOUT_SERVICE_COLLAGE.map((asset) => (
							<img
								src={asset.src}
								alt={asset.alt}
								style={asset.position ? `object-position: ${asset.position}` : undefined}
								loading="lazy"
							/>
						))
					}
				</div>
			</div>
		</div>
	</section>

	{
		galleryItems.length > 0 && (
			<section class="section section--muted">
				<div class="section__header">
					<p class="eyebrow">Our Work</p>
					<h2>See what we create</h2>
				</div>
				<GalleryGrid items={galleryItems} />
				<div class="section__footer">
					<a class="btn btn--secondary" href="/gallery">Full gallery</a>
				</div>
			</section>
		)
	}
</Base>
