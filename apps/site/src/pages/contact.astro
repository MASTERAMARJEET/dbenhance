---
import Base from "../layouts/Base.astro";
import { getLocationsInOrder, whatsappUrl } from "../data/locations";
import { getActiveCityId } from "../utils/city-context";
import { getCityCopy } from "../utils/city-copy";
import { getPageImage } from "../utils/site-media";

const cityId = getActiveCityId(Astro.locals);
const cityCopy = getCityCopy(cityId);
const locations = getLocationsInOrder(cityId);
const contactHero = getPageImage("contactHero");
---

<Base
	title="Contact"
	description={cityCopy.contactDescription}
	fullWidth
	image={contactHero}
>
	<section class="page-hero page-hero--visual page-hero--short">
		<img class="page-hero__bg" src={contactHero} alt="" />
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">Get in touch</p>
			<h1>Contact Us</h1>
			<p class="page-hero__lead">{cityCopy.contactHeroLead}</p>
		</div>
	</section>

	<section class="section">
		<div class="contact-locations">
			{
				locations.map((loc) => (
					<section class="contact-card">
						<h2>Visit us</h2>
						<p>
							<a href={loc.mapsUrl} target="_blank" rel="noopener noreferrer">
								<strong>{loc.heading}</strong>
							</a>
							<br />
							{loc.addressLines.map((line) => (
								<>
									{line}
									<br />
								</>
							))}
						</p>
						<p class="contact-card__phones">
							{
								loc.phones.map((p, i) => (
									<span class="contact-card__phone-line">
										<a href={`tel:${p.tel}`}>{p.display}</a>
										{i === 0 && (
											<>
												{" "}
												<span class="muted">·</span>{" "}
												<a
													href={whatsappUrl(loc)}
													target="_blank"
													rel="noopener noreferrer"
												>
													WhatsApp
												</a>
											</>
										)}
									</span>
								))
							}
						</p>
						<h3 class="contact-card__subhead">Opening hours</h3>
						<ul class="hours-list">
							{
								loc.hours.map((row) => (
									<li class="hours-list__item">
										<span class="hours-list__label">{row.label}</span>
										<span class="hours-list__value">{row.time}</span>
									</li>
								))
							}
						</ul>
					</section>
				))
			}
		</div>

		<div class="contact-maps">
			{
				locations.map((loc) => (
					<div class="contact-map">
						<h3 class="contact-map__title">{loc.heading}</h3>
						<iframe
							src={loc.mapsEmbedSrc}
							width="600"
							height="450"
							style="border:0;"
							allowfullscreen
							loading="lazy"
							referrerpolicy="strict-origin-when-cross-origin"
							title={`${loc.heading} on Google Maps`}
						/>
					</div>
				))
			}
		</div>
	</section>
</Base>
