---
import Base from "../layouts/Base.astro";
import { getPageImage } from "../utils/site-media";

const contactHero = getPageImage("contactHero");
---

<Base
	title="Contact"
	description="Get in touch with DB Enhance salon in Padur, Chennai. Call 9043047266 or email contact@dbenhance.com to book hair, nail, or beauty services."
	fullWidth
	image={contactHero}
>
	<section class="page-hero page-hero--visual page-hero--short">
		<img
			class="page-hero__bg"
			src={contactHero}
			alt=""
		/>
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">Get in touch</p>
			<h1>Contact Us</h1>
			<p class="page-hero__lead">
				Book an appointment, ask about services, or enquire about bridal and
				package options.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="contact-grid">
			<section class="contact-card">
				<h2>Visit us</h2>
				<p>
					<a
						href="https://maps.app.goo.gl/arPLnDvLWizfWch17"
						target="_blank"
						rel="noopener noreferrer"
					>
						<strong>DB Enhance — The Unisex Salon</strong>
					</a><br />
					S3, 2nd Floor, Godrej Azure Elsa Plaza<br />
					No. 2, Rajiv Gandhi Salai, Padur<br />
					Chennai – 603103
				</p>
			</section>

			<section class="contact-card">
				<h2>Call or email</h2>
				<p>
					<a href="tel:9043047266">9043047266</a><br />
					<a href="tel:04435642646">044-35642646</a><br />
					<a href="mailto:contact@dbenhance.com">contact@dbenhance.com</a>
				</p>
			</section>

			<section class="contact-card">
				<h2>Opening hours</h2>
				<ul class="hours-list">
					<li class="hours-list__item">
						<span class="hours-list__label">Monday – Friday</span>
						<span class="hours-list__value">10:00 AM – 9:00 PM</span>
					</li>
					<li class="hours-list__item">
						<span class="hours-list__label">Saturday & Sunday</span>
						<span class="hours-list__value">9:00 AM – 9:00 PM</span>
					</li>
				</ul>
			</section>
		</div>

		<div class="contact-map">
			<iframe
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d284.199141610584!2d80.22670791116917!3d12.80772376770231!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a525b6f96e7e3e1%3A0x3919676bb609ed1c!2sDB%20Enhance!5e0!3m2!1sen!2sin!4v1786890045955!5m2!1sen!2sin"
				width="600"
				height="450"
				style="border:0;"
				allowfullscreen
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
				title="DB Enhance salon location on Google Maps"
			></iframe>
		</div>
	</section>
</Base>
