---
import Base from "../layouts/Base.astro";
import {
	SITE_EMAIL,
	getDefaultLocation,
	getLocationsInOrder,
	whatsappUrl,
} from "../data/locations";
import { getPageImage } from "../utils/site-media";

const locations = getLocationsInOrder();
const defaultLocation = getDefaultLocation();
const contactHero = getPageImage("contactHero");
---

<Base
	title="Contact"
	description="Get in touch with DB Enhance in Bangalore and Chennai. Call, WhatsApp, or visit either salon to book hair, nail, or beauty services."
	fullWidth
	image={contactHero}
>
	<section class="page-hero page-hero--visual page-hero--short">
		<img class="page-hero__bg" src={contactHero} alt="" />
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">Get in touch</p>
			<h1>Contact Us</h1>
			<p class="page-hero__lead">
				Book an appointment at our Bangalore or Chennai salon, ask about services,
				or enquire about bridal and package options.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="contact-locations">
			{
				locations.map((loc) => (
					<section class="contact-card">
						<h2>Visit us</h2>
						<p>
							<a href={loc.mapsUrl} target="_blank" rel="noopener noreferrer">
								<strong>{loc.heading}</strong>
							</a>
							<br />
							{loc.addressLines.map((line) => (
								<>
									{line}
									<br />
								</>
							))}
						</p>
						<p>
							{
								loc.phones.map((p, i) => (
									<>
										{i > 0 && <br />}
										<a href={`tel:${p.tel}`}>{p.display}</a>
									</>
								))
							}
						</p>
					</section>
				))
			}

			<section class="contact-card">
				<h2>Call, email & WhatsApp</h2>
				<p>
					{
						locations.flatMap((loc) =>
							loc.phones.map((p) => ({ loc: loc.label, ...p })),
						).map((p, i) => (
							<>
								{i > 0 && <br />}
								<span class="muted">{p.loc}:</span>{" "}
								<a href={`tel:${p.tel}`}>{p.display}</a>
							</>
						))
					}
					<br />
					<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
					<br />
					<a href={whatsappUrl(defaultLocation)} target="_blank" rel="noopener noreferrer">
						WhatsApp ({defaultLocation.label})
					</a>
				</p>
			</section>

			<section class="contact-card">
				<h2>Opening hours</h2>
				<ul class="hours-list">
					<li class="hours-list__item">
						<span class="hours-list__label">Monday – Friday</span>
						<span class="hours-list__value">10:00 AM – 9:00 PM</span>
					</li>
					<li class="hours-list__item">
						<span class="hours-list__label">Saturday & Sunday</span>
						<span class="hours-list__value">9:00 AM – 9:00 PM</span>
					</li>
				</ul>
			</section>
		</div>

		<div class="contact-maps">
			{
				locations.map((loc) => (
					<div class="contact-map">
						<h3 class="contact-map__title">{loc.heading}</h3>
						<iframe
							src={loc.mapsEmbedSrc}
							width="600"
							height="450"
							style="border:0;"
							allowfullscreen
							loading="lazy"
							referrerpolicy="strict-origin-when-cross-origin"
							title={`${loc.heading} on Google Maps`}
						/>
					</div>
				))
			}
		</div>
	</section>
</Base>
