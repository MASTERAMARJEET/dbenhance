---
import Base from "../layouts/Base.astro";
import {
	BOOKING_LEAD_EMAILS,
	SITE_EMAIL,
	getLocationsInOrder,
} from "../data/locations";

const locations = getLocationsInOrder();
const leadEmails = BOOKING_LEAD_EMAILS.join(", ");
---

<Base
	title="Privacy Policy"
	description="Privacy Policy for DB Enhance — how we collect, use, and protect your personal information when you use our website or book an appointment."
>
	<article class="article privacy">
		<p class="eyebrow">Legal</p>
		<h1>Privacy Policy</h1>
		<p class="muted">
			<strong>Draft for review</strong> — last updated {new Date().toLocaleDateString("en-IN", { year: "numeric", month: "long", day: "numeric" })}.
			This page describes how DB Enhance (“we”, “us”) handles personal information
			collected through dbenhance.com and related booking channels.
		</p>

		<section>
			<h2>Who we are</h2>
			<p>
				DB Enhance operates unisex salon locations in Bangalore and Chennai. Contact
				details for each branch are listed on our
				<a href="/contact">Contact</a> page. You can also email us at
				<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>.
			</p>
		</section>

		<section>
			<h2>Information we collect</h2>
			<p>We may collect:</p>
			<ul>
				<li>
					<strong>Enquiry / booking details</strong> you submit via the “Book an
					Appointment” form — such as name, mobile number, preferred location,
					service of interest, and any message you include.
				</li>
				<li>
					<strong>Contact details</strong> you share when you call, email, or message
					us on WhatsApp or social media.
				</li>
				<li>
					<strong>Technical data</strong> such as approximate location derived from
					IP address (when used for analytics or future city personalisation),
					browser type, and pages visited — typically via cookies or similar tools.
				</li>
			</ul>
		</section>

		<section>
			<h2>How we use your information</h2>
			<ul>
				<li>To respond to appointment and service enquiries</li>
				<li>To confirm bookings and provide salon services</li>
				<li>To improve our website and understand visitor interest</li>
				<li>To comply with legal obligations where applicable</li>
			</ul>
			<p>
				Appointment form submissions are emailed to our salon team (including
				{leadEmails}) so the relevant branch can follow up.
			</p>
		</section>

		<section>
			<h2>Cookies and analytics</h2>
			<p>
				We may use Google Tag Manager and related analytics/advertising tags to
				understand how the site is used. These tools may set cookies or use similar
				identifiers. You can control cookies through your browser settings.
			</p>
		</section>

		<section>
			<h2>Sharing</h2>
			<p>
				We do not sell your personal information. We may share data with service
				providers who help us operate the website (for example hosting on Cloudflare,
				or email delivery for booking enquiries), solely to perform those services.
				We may also disclose information if required by law.
			</p>
		</section>

		<section>
			<h2>Retention</h2>
			<p>
				We keep enquiry and contact records only as long as needed to handle your
				request and for ordinary business records, unless a longer period is required
				by law.
			</p>
		</section>

		<section>
			<h2>Your choices</h2>
			<p>
				To access, correct, or ask us to delete personal information we hold about
				you in connection with website enquiries, email
				<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a> or contact your preferred
				branch:
			</p>
			<ul>
				{
					locations.map((loc) => (
						<li>
							{loc.label}:{" "}
							{loc.phones.map((p, i) => (
								<>
									{i > 0 && ", "}
									<a href={`tel:${p.tel}`}>{p.display}</a>
								</>
							))}
						</li>
					))
				}
			</ul>
		</section>

		<section>
			<h2>Changes</h2>
			<p>
				We may update this Privacy Policy from time to time. The “last updated” date
				at the top of this page will change when we do. Continued use of the site
				after changes means you accept the updated policy.
			</p>
		</section>

		<section>
			<h2>Contact</h2>
			<p>
				Questions about this policy:
				<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a> ·
				<a href="/contact">Contact page</a>
			</p>
		</section>
	</article>
</Base>

<style>
	.privacy section {
		margin-top: var(--space-6);
	}

	.privacy h2 {
		font-size: 1.25rem;
		margin-bottom: var(--space-2);
	}

	.privacy ul {
		padding-left: 1.25rem;
	}

	.privacy li {
		margin-bottom: var(--space-2);
	}
</style>
