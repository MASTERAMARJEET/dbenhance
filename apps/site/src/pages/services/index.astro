---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import VisualCard from "../../components/VisualCard.astro";
import {
	SERVICE_CATEGORY_ORDER,
	SERVICE_CATEGORIES,
} from "../../utils/service-categories";
import { CATEGORY_IMAGES, getPageImage, getServiceImage } from "../../utils/site-media";

interface TestimonialView {
	title: string;
	quote: string | null;
	imageSrc: string | null;
	imageAlt: string;
	videoSrc: string | null;
	locationLabel: string | null;
}

const servicesHero = getPageImage("servicesHero");

const { entries: services, cacheHint } = await getEmDashCollection("services", {
	status: "published",
	limit: 100,
});

let testimonials: TestimonialView[] = [];
let testimonialsCacheHint: Awaited<ReturnType<typeof getEmDashCollection>>["cacheHint"] | undefined;

try {
	const result = await getEmDashCollection("testimonials" as "services", {
		status: "published",
		limit: 24,
	});
	testimonialsCacheHint = result.cacheHint;
	testimonials = [...result.entries]
		.sort(
			(a, b) =>
				(Number((a.data as { sort_order?: number }).sort_order) || 0) -
				(Number((b.data as { sort_order?: number }).sort_order) || 0),
		)
		.map((item) => {
			const data = item.data as {
				title?: string;
				quote?: string | null;
				media?: { src?: string; url?: string; alt?: string } | null;
				video?: { src?: string; url?: string } | null;
				location?: string | null;
			};
			const location = data.location;
			return {
				title: data.title ?? "Client",
				quote: data.quote ?? null,
				imageSrc: data.media?.src ?? data.media?.url ?? null,
				imageAlt: data.media?.alt || data.title || "Client testimonial",
				videoSrc: data.video?.src ?? data.video?.url ?? null,
				locationLabel: location
					? `${location.charAt(0).toUpperCase()}${location.slice(1)}`
					: null,
			};
		});
} catch {
	// Collection may not exist until schema is migrated / types regenerated
}

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (testimonialsCacheHint) Astro.cache.set(testimonialsCacheHint);
}

const grouped = Object.fromEntries(
	SERVICE_CATEGORY_ORDER.map((key) => [
		key,
		services.filter((s) => s.data.category === key),
	]),
);
---

<Base
	title="Services"
	description="Explore DB Enhance services — salon hair care, non-surgical hair fixing, nail art, facials, waxing, makeup, and bridal packages in Bangalore and Chennai."
	fullWidth
	image={servicesHero}
>
	<section class="page-hero page-hero--visual page-hero--short">
		<img
			class="page-hero__bg"
			src={servicesHero}
			alt=""
		/>
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">DB Enhance</p>
			<h1>Our Services</h1>
			<p class="page-hero__lead">
				Salon hair, hair fixing, nails, skin, and grooming — call us for
				details and appointments at Bangalore or Chennai.
			</p>
		</div>
	</section>

	{
		SERVICE_CATEGORY_ORDER.map((key) => {
			const items = grouped[key];
			if (!items?.length) return null;
			return (
				<section class="section service-category-section">
					<div class="service-category-section__intro">
						<div class="split split--visual split--reverse">
							<div class="split__media split__media--tall">
								<img
									src={CATEGORY_IMAGES[key].src}
									alt={CATEGORY_IMAGES[key].alt}
									style={
										CATEGORY_IMAGES[key].position
											? `object-position: ${CATEGORY_IMAGES[key].position}`
											: undefined
									}
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="split__content">
								<p class="eyebrow">{SERVICE_CATEGORIES[key].label}</p>
								<h2>{SERVICE_CATEGORIES[key].label}</h2>
								<p>{SERVICE_CATEGORIES[key].description}</p>
								<div class="service-chip-list">
									{items.map((service) => (
										<a
											class="service-chip"
											href={`/services/${service.data.slug}`}
										>
											<span {...service.edit.title}>{service.data.title}</span>
										</a>
									))}
								</div>
							</div>
						</div>
					</div>
					<div class="service-category-section__featured visual-grid visual-grid--3">
						{items.slice(0, 3).map((service) => (
							<VisualCard
								href={`/services/${service.data.slug}`}
								image={getServiceImage(
									service.data.slug ?? "",
									service.data.category,
								)}
								title={service.data.title}
								description={service.data.excerpt}
								cta="View service →"
							/>
						))}
					</div>
				</section>
			);
		})
	}

	{
		testimonials.length > 0 && (
			<section class="section section--muted">
				<div class="section__header">
					<p class="eyebrow">Testimonials</p>
					<h2>What clients say</h2>
					<p class="muted">Real experiences from our Bangalore and Chennai guests.</p>
				</div>
				<div class="testimonials">
					{testimonials.map((item) => (
						<article class="testimonial-card">
							{(item.videoSrc || item.imageSrc) && (
								<div class="testimonial-card__media">
									{item.videoSrc ? (
										<video
											src={item.videoSrc}
											poster={item.imageSrc ?? undefined}
											controls
											playsinline
											preload="metadata"
										/>
									) : (
										<img
											src={item.imageSrc!}
											alt={item.imageAlt}
											loading="lazy"
										/>
									)}
								</div>
							)}
							<div class="testimonial-card__body">
								{item.quote && (
									<p class="testimonial-card__quote">“{item.quote}”</p>
								)}
								<p class="testimonial-card__meta">
									{item.title}
									{item.locationLabel ? ` · ${item.locationLabel}` : ""}
								</p>
							</div>
						</article>
					))}
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="cta-inline">
			<p>Questions about a service? We're happy to help.</p>
			<a class="btn btn--primary" href="/contact">Get in touch</a>
		</div>
	</section>
</Base>
