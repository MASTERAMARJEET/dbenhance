---
import Base from "../layouts/Base.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import ReelStrip from "../components/ReelStrip.astro";
import { getFeaturedReels, getGalleryItems } from "../utils/social-content";
import { getDefaultLocation, SOCIAL_LINKS } from "../data/locations";
import { getPageImage } from "../utils/site-media";

const galleryHero = getPageImage("galleryHero");
const defaultLocation = getDefaultLocation();

const [featuredReelsResult, galleryItemsResult] = await Promise.all([
	getFeaturedReels(),
	getGalleryItems(),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(featuredReelsResult.cacheHint);
	Astro.cache.set(galleryItemsResult.cacheHint);
}

const featuredReels = featuredReelsResult.reels;
const galleryItems = galleryItemsResult.items;

const displayReels = featuredReels.filter(
	(reel) => reel.posterSrc || reel.videoSrc,
);
const displayGallery = galleryItems.filter((item) => item.src);
---

<Base
	title="Gallery"
	description="Browse hair styling, nail care, makeup, and salon transformations from DB Enhance in Bangalore and Chennai."
	fullWidth
	image={galleryHero}
>
	<section class="page-hero page-hero--visual">
		<img
			class="page-hero__bg"
			src={galleryHero}
			alt=""
		/>
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">DB Enhance</p>
			<h1>Our Work</h1>
			<p class="page-hero__lead">
				Hair patch, extensions, nail care, bridal makeup, and more — from our
				Bangalore and Chennai salons.
			</p>
		</div>
	</section>

	{
		displayReels.length > 0 && (
			<section class="section">
				<div class="section__header section__header--split">
					<div>
						<p class="eyebrow">Reels</p>
						<h2>Watch transformations</h2>
					</div>
					<a class="text-link" href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">
						Follow @dbenhance →
					</a>
				</div>
				<ReelStrip reels={displayReels} />
			</section>
		)
	}

	{
		displayGallery.length > 0 ? (
			<section class="section section--muted">
				<div class="section__header">
					<p class="eyebrow">Gallery</p>
					<h2>Recent work</h2>
					<p class="muted">
						Tap any image to view the full post on Instagram. Work from both
						Bangalore and Chennai when available.
					</p>
				</div>
				<GalleryGrid items={displayGallery} />
			</section>
		) : (
			<section class="section section--muted">
				<div class="gallery-empty">
					<p class="eyebrow">Gallery</p>
					<h2>Coming soon</h2>
					<p>
						We’re preparing photos of Hair Patch, Hair Extension, Nail Care,
						Bridal Make Up, and more from our Bangalore and Chennai salons.
						Follow us on Instagram meanwhile.
					</p>
					<p>
						<a class="btn btn--secondary" href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">
							@dbenhance on Instagram
						</a>
					</p>
				</div>
			</section>
		)
	}

	<section class="section">
		<div class="cta-inline">
			<p>Ready for your transformation?</p>
			<a class="btn btn--primary" href="/contact">Book an appointment</a>
			<a class="btn btn--secondary" href={`tel:${defaultLocation.primaryPhone.tel}`}>
				Call {defaultLocation.primaryPhone.display}
			</a>
		</div>
	</section>
</Base>
