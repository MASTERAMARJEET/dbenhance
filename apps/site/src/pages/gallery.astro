---
import Base from "../layouts/Base.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import ReelStrip from "../components/ReelStrip.astro";
import { getFeaturedReels, getGalleryItems } from "../utils/social-content";
import { INSTAGRAM_PROFILE, getPageImage } from "../utils/site-media";

const galleryHero = getPageImage("galleryHero");

const [featuredReels, galleryItems] = await Promise.all([
	getFeaturedReels(),
	getGalleryItems(),
]);

const displayReels = featuredReels.filter(
	(reel) => reel.posterSrc || reel.videoSrc,
);
const displayGallery = galleryItems.filter((item) => item.src);
---

<Base
	title="Gallery"
	description="Browse hair styling, nail care, makeup, and salon transformations from DB Enhance in Padur, Chennai."
	fullWidth
	image={galleryHero}
>
	<section class="page-hero page-hero--visual">
		<img
			class="page-hero__bg"
			src={galleryHero}
			alt=""
		/>
		<div class="page-hero__scrim" />
		<div class="page-hero__content">
			<p class="eyebrow eyebrow--light">DB Enhance</p>
			<h1>Our Work</h1>
			<p class="page-hero__lead">
				Hair transformations, styling, and salon finishes — straight from our
				chair in Padur.
			</p>
		</div>
	</section>

	{
		displayReels.length > 0 && (
			<section class="section">
				<div class="section__header section__header--split">
					<div>
						<p class="eyebrow">Reels</p>
						<h2>Watch transformations</h2>
					</div>
					<a class="text-link" href={INSTAGRAM_PROFILE} target="_blank" rel="noopener noreferrer">
						Follow @dbenhance →
					</a>
				</div>
				<ReelStrip reels={displayReels} />
			</section>
		)
	}

	{
		displayGallery.length > 0 && (
			<section class="section section--muted">
				<div class="section__header">
					<p class="eyebrow">Gallery</p>
					<h2>Recent work</h2>
					<p class="muted">
						Tap any image to view the full post on Instagram.
					</p>
				</div>
				<GalleryGrid items={displayGallery} />
			</section>
		)
	}

	<section class="cta-inline">
		<p>Ready for your transformation?</p>
		<a class="btn btn--primary" href="/contact">Book an appointment</a>
		<a class="btn btn--secondary" href="tel:9043047266">Call 9043047266</a>
	</section>
</Base>
