---
import type { ImageAsset } from "../utils/site-media";

interface Props {
	href: string;
	image: string | ImageAsset;
	title: string;
	description?: string;
	cta?: string;
}

const {
	href,
	image,
	title,
	description,
	cta = "Explore →",
} = Astro.props;

const asset = typeof image === "string" ? { src: image, alt: title } : image;

const MAX_DESCRIPTION = 80;
const blurb =
	description && description.length > MAX_DESCRIPTION
		? `${description.slice(0, MAX_DESCRIPTION).replace(/\s+\S*$/, "")}…`
		: description;
---

<a class="visual-card" href={href}>
	<img
		class="visual-card__image"
		src={asset.src}
		alt={asset.alt}
		style={asset.position ? `object-position: ${asset.position}` : undefined}
		loading="lazy"
		decoding="async"
	/>
	<div class="visual-card__overlay">
		<h3 class="visual-card__title">{title}</h3>
		{blurb && <p class="visual-card__text">{blurb}</p>}
		<span class="visual-card__cta">{cta}</span>
	</div>
</a>
