---
import { getMenu, getSiteSettings } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { INSTAGRAM_PROFILE } from "../utils/site-media";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	fullWidth?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, fullWidth = false, content } = Astro.props;
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon-light.png" type="image/png" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/favicon-light.png" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<nav class="site-nav">
				<a class="site-brand" href="/">
					{siteLogo
						? <img class="site-logo" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						: siteTitle
					}
				</a>
				<div class="site-nav-links">
					{
						menu?.items.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))
					}
				</div>
				<LiveSearch
					class="site-search"
					inputClass="site-search-input"
					placeholder="Search..."
					collections={["pages", "services"]}
				/>
			</nav>
		</header>

		<main class:list={["site-main", fullWidth && "site-main--full"]}>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div>
					<p class="site-footer__brand">{siteTitle}</p>
					<p class="site-footer__tagline">{siteTagline ?? "The Unisex Salon"}</p>
				</div>
				<div class="site-footer__contact">
					<p>
						S3, 2nd Floor, Godrej Azure Elsa Plaza<br />
						Rajiv Gandhi Salai, Padur, Chennai – 603103
					</p>
					<p>
						<a href="tel:9043047266">9043047266</a> ·
						<a href="mailto:contact@dbenhance.com">contact@dbenhance.com</a>
					</p>
				</div>
				<div class="site-footer__hours">
					<p>Mon–Fri: 10 AM – 9 PM</p>
					<p>Sat–Sun: 9 AM – 9 PM</p>
					<p>
						<a href={INSTAGRAM_PROFILE} target="_blank" rel="noopener noreferrer">
							@dbenhance on Instagram
						</a>
					</p>
				</div>
			</div>
			<p class="site-footer__copy">© {new Date().getFullYear()} {siteTitle}</p>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
