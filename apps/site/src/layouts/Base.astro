---
import { getMenu, getSiteSettings } from "emdash";
import {
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import {
	SITE_EMAIL,
	SOCIAL_LINKS,
	getDefaultLocation,
	getLocationsInOrder,
	whatsappUrl,
} from "../data/locations";
import AppointmentFloat from "../components/AppointmentFloat.astro";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	fullWidth?: boolean;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, fullWidth = false, content } = Astro.props;
const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;

const menu = await getMenu("primary");
const defaultLocation = getDefaultLocation();
const locations = getLocationsInOrder();
const waUrl = whatsappUrl(defaultLocation);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		{pageDescription && <meta name="description" content={pageDescription} />}
		{canonical && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon-light.png" type="image/png" media="(prefers-color-scheme: light)" />
		<link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/favicon-light.png" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<nav class="site-nav">
				<a class="site-brand" href="/">
					{siteLogo
						? <img class="site-logo" src={siteLogo.url} alt={siteLogo.alt || siteTitle} />
						: siteTitle
					}
				</a>
				<div class="site-nav-links">
					{
						menu?.items.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))
					}
				</div>
				<a
					class="site-header-phone"
					href={`tel:${defaultLocation.primaryPhone.tel}`}
				>
					{defaultLocation.primaryPhone.display}
				</a>
			</nav>
		</header>

		<main class:list={["site-main", fullWidth && "site-main--full"]}>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<div>
					<p class="site-footer__brand">{siteTitle}</p>
					<p class="site-footer__tagline">{siteTagline ?? "The Unisex Salon"}</p>
					<p class="site-footer__social">
						<a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
						{" · "}
						<a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
						{" · "}
						<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
					</p>
				</div>
				<div class="site-footer__locations">
					{
						locations.map((loc) => (
							<div class="site-footer__location">
								<p class="site-footer__location-title">{loc.heading}</p>
								<p>
									{loc.addressLines.map((line, i) => (
										<>
											{i > 0 && <br />}
											{line}
										</>
									))}
								</p>
								<p>
									{
										loc.phones.map((p, i) => (
											<>
												{i > 0 && " · "}
												<a href={`tel:${p.tel}`}>{p.display}</a>
											</>
										))
									}
								</p>
							</div>
						))
					}
					<p>
						<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
					</p>
				</div>
				<div class="site-footer__hours">
					<p>{defaultLocation.hours.weekdays}</p>
					<p>{defaultLocation.hours.weekend}</p>
					<p>
						<a href="/privacy">Privacy Policy</a>
					</p>
				</div>
			</div>
			<p class="site-footer__copy">
				© {new Date().getFullYear()} {siteTitle}
			</p>
		</footer>

		<a
			class="float-whatsapp"
			href={waUrl}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Chat on WhatsApp"
		>
			<span class="float-whatsapp__icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
				</svg>
			</span>
		</a>

		<AppointmentFloat />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
