{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dbenhance-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "placement": {
    "mode": "smart"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "dbenhance.com", "custom_domain": true },
    { "pattern": "www.dbenhance.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dbenhance-site"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dbenhance-media"
    }
  ]
}
