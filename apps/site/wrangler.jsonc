{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dbenhance-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "68178f00cd6546069cbe18161da385f6"
    }
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "dbenhance.com", "custom_domain": true },
    { "pattern": "www.dbenhance.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dbenhance-site"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dbenhance-media"
    }
  ],
  "env": {
    "remote": {
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dbenhance-site",
          "database_id": "f32c1e39-7ee9-4bcc-9bee-27cb14178b35",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "dbenhance-media",
          "remote": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "68178f00cd6546069cbe18161da385f6",
          "remote": true
        }
      ]
    }
  }
}
