{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dbenhance-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-04",
  "placement": {
    "mode": "smart"
  },
  "cache": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "68178f00cd6546069cbe18161da385f6"
    }
  ],
  "workers_dev": false,
  "routes": [
    { "pattern": "dbenhance.com", "custom_domain": true },
    { "pattern": "www.dbenhance.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dbenhance-site",
      "database_id": "f32c1e39-7ee9-4bcc-9bee-27cb14178b35"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "dbenhance-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["bookings@dbenhance.com"],
      "allowed_destination_addresses": [
        "dbenhance.blr@gmail.com",
        "rekha.dbenhance@gmail.com"
      ]
    }
  ],
  "vars": {
    "EMDASH_SITE_URL": "https://dbenhance.com",
    "BOOKING_FROM_EMAIL": "bookings@dbenhance.com"
  },
  "env": {
    "dev": {
      "name": "dbenhance-site-dev",
      "workers_dev": true,
      "routes": [],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dbenhance-site-dev",
          "database_id": "b9282a61-50cd-4d21-a64b-6b57bc56ad2c",
          "remote": true
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "dbenhance-media-dev",
          "remote": true
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "5f076f63c7a6410f8eea9a279a7db85b",
          "remote": true
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["bookings@dbenhance.com"],
          "allowed_destination_addresses": [
            "dbenhance.blr@gmail.com",
            "rekha.dbenhance@gmail.com"
          ],
          "remote": true
        }
      ],
      "vars": {
        // Must match config/dev.mjs (validated by pnpm check:dev-config)
        "EMDASH_SITE_URL": "https://dbenhance-site-dev.masteramarjeetkumar.workers.dev",
        "BOOKING_FROM_EMAIL": "bookings@dbenhance.com"
      }
    }
  }
}
