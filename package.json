{
  "name": "dbenhance",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:remote": "pnpm --filter site dev:remote",
    "deploy:site": "turbo run site#deploy",
    "deploy:dev": "pnpm --filter site deploy:dev",
    "sync:data": "node scripts/sync-data.mjs",
    "clean": "rimraf **/node_modules **/.turbo **/dist **/.wrangler",
    "clean:install": "pnpm clean && pnpm install"
  },
  "devDependencies": {
    "mcp-remote": "^0.1.38",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.10"
  }
}