{
  "name": "dbenhance",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0"
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build:prod": "turbo run build:prod",
    "build:dev": "pnpm --filter site build:dev",
    "dev": "turbo run dev --parallel",
    "deploy:site:prod": "turbo run site#deploy:prod",
    "deploy:site:dev": "pnpm --filter site deploy:dev",
    "check:prod-config": "pnpm --filter site check:prod-config",
    "check:dev-config": "pnpm --filter site check:dev-config",
    "typecheck": "pnpm --filter site typecheck",
    "clean": "rimraf **/node_modules **/.turbo **/dist **/.wrangler",
    "clean:install": "pnpm clean && pnpm install"
  },
  "devDependencies": {
    "mcp-remote": "^0.1.38",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.10"
  }
}