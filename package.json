{
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "deploy:site": "turbo run site#deploy",
    "clean": "rimraf **/node_modules **/.turbo **/dist **/.wrangler",
    "clean:install": "pnpm clean && pnpm install"
  },
  "devDependencies": {
    "rimraf": "^4.1.1",
    "turbo": "^1.7.0"
  }
}
