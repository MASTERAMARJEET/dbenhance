{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build:prod": {
      "dependsOn": [
        "^build:prod"
      ],
      "outputs": [
        "dist/**",
        ".wrangler/**"
      ]
    },
    "dev": {
      "cache": false
    },
    "deploy:prod": {
      "dependsOn": [
        "build:prod"
      ],
      "cache": false
    }
  }
}
